# Server
PORT=3001
HTTP_PORT=3080
NODE_ENV=development

# Database (MySQL via XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wasiyya

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Session (used only for OAuth redirect cycle)
SESSION_SECRET=your_session_secret_minimum_32_characters

# AES-256-GCM document encryption key (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AES_SECRET_KEY=your_64_char_hex_key_here

# Email (Gmail App Password recommended)
# Leave EMAIL_USER/EMAIL_PASS empty or as placeholders to use Ethereal test accounts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Wasiyya <your_email@gmail.com>

# Frontend URL (used for OAuth redirect, CORS, emails)
# HTTP dev:  http://localhost:3000
# HTTPS dev: https://localhost:3000  (after npm run ssl:generate + USE_HTTPS=true)
FRONTEND_URL=http://localhost:3000

# Backend URL (OAuth callback base — must match Google/GitHub app settings)
BACKEND_URL=http://localhost:3001

# OAuth — Google (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# WebAuthn / Passkey (2FA) — RP ID must match site hostname (localhost for dev)
WEBAUTHN_RP_NAME=Wasiyya
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# With HTTPS: WEBAUTHN_ORIGIN=https://localhost:3000

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Dead Man's Switch time unit
# "days"    — production mode (cron runs daily at 9am)
# "minutes" — testing mode (cron runs every minute)
TIME_UNIT=minutes

# HTTPS — see docs/SSL.md
# Local dev (trusted after npm run ssl:trust): mkcert → npm run ssl:generate
# Production (global trust): Let's Encrypt → scripts/setup-letsencrypt.sh yourdomain.com
# USE_HTTPS=true
# DOMAIN=wasiyya.com
# SSL_CERT_PATH=./certs/server.cert
# SSL_KEY_PATH=./certs/server.key
# Production example:
# SSL_CERT_PATH=/etc/letsencrypt/live/wasiyya.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/wasiyya.com/privkey.pem
