# Server
PORT=3001
NODE_ENV=development

# Database (MySQL via XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wasiyya

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Email (Brevo SMTP recommended)
# Leave EMAIL_USER/EMAIL_PASS empty or as placeholders to use Ethereal test accounts


EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_smtp_key
EMAIL_FROM=Wasiyya <no-reply@yourdomain.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Dead Man's Switch time unit
# "days"    — production mode (cron runs daily at 9am)
# "minutes" — testing mode (cron runs every minute)
TIME_UNIT=days
