{
  "name": "wasiyya-backend",
  "version": "1.0.0",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:verbose": "jest --forceExit --detectOpenHandles --verbose",
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "ssl:generate": "node scripts/generate-ssl.js",
    "ssl:generate:force": "node scripts/generate-ssl.js -- --force",
    "ssl:openssl": "bash scripts/generate-ssl-openssl.sh",
    "ssl:trust": "bash scripts/install-mkcert-ca.sh",
    "dev:https": "npm run ssl:generate && nodemon src/app.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^11.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
